# --- Score File ---
score_file = "email_scores.json"
if not os.path.exists(score_file):
    with open(score_file, "w") as f:
        json.dump({}, f)

def save_score(email, new_score):
    with open(score_file, "r+") as f:
        scores = json.load(f)
        if email in scores:
            scores[email].append(new_score)
        else:
            scores[email] = [new_score]
        f.seek(0)
        json.dump(scores, f)
        f.truncate()

def load_scores(email):
    with open(score_file, "r") as f:
        scores = json.load(f)
        return scores.get(email, [])

def plot_score_comparison(email, current_score):
    scores = load_scores(email)
    scores.append(current_score)
    attempts = list(range(1, len(scores) + 1))

    fig, ax = plt.subplots()
    ax.plot(attempts, scores, marker='o', linestyle='-', color='blue')
    ax.set_title(f"Score Progress for {email}")
    ax.set_xlabel("Attempt")
    ax.set_ylabel("Score")
    ax.grid(True)
    st.pyplot(fig)


