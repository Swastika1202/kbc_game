# --- Session State ---
if "email" not in st.session_state:
    st.session_state.email = ""
    st.session_state.email_entered = False
    st.session_state.quiz_started = False
    st.session_state.q_index = 0
    st.session_state.score = 0
    st.session_state.finished = False
    st.session_state.selected_field = None
    st.session_state.user_answers = []
    st.session_state.submitted = False

# --- UI ---
st.title("Tech Quiz Challenge")

if not st.session_state.email_entered:
    email = st.text_input("Enter your email to begin:")
    if st.button("Confirm Email") and email:
        st.session_state.email = email
        st.session_state.email_entered = True
        st.success(f"Welcome, {email}!")
        previous_scores = load_scores(email)
        if previous_scores:
            st.info(f"Previous attempts: {len(previous_scores)} | Last Score: {previous_scores[-1]}")
        else:
            st.info("No previous attempts found. Let's begin!")

# --- Quiz Selection ---
if st.session_state.email_entered and not st.session_state.quiz_started:
    st.subheader("Choose your domain and test your knowledge!")
    field = st.selectbox("Select your field:", list(quiz_data.keys()))
    if st.button("Start Quiz"):
        st.session_state.quiz_started = True
        st.session_state.q_index = 0
        st.session_state.score = 0
        st.session_state.finished = False
        st.session_state.selected_field = field
        st.session_state.user_answers = []
        st.session_state.submitted = False

# --- Quiz Flow ---
if st.session_state.quiz_started and not st.session_state.finished:
    data = quiz_data[st.session_state.selected_field]
    q_idx = st.session_state.q_index

    st.markdown(f"**Question {q_idx + 1}:** {data['questions'][q_idx]}")
    user_answer = st.radio("Choose your answer:", data['options'][q_idx], key=q_idx)

    if st.button("Submit Answer") and not st.session_state.submitted:
        correct = data['options'][q_idx][data['answers'][q_idx]]
        st.session_state.user_answers.append(user_answer)
        if user_answer == correct:
            st.success("Correct!")
            st.session_state.score += 50
        else:
            st.warning("Incorrect!")
            st.info(f"Correct Answer: {correct}")
        st.session_state.submitted = True

    if st.session_state.submitted:
        if st.button("Next Question"):
            st.session_state.q_index += 1
            st.session_state.submitted = False

        if st.session_state.q_index >= len(data["questions"]):
            st.session_state.finished = True
            st.session_state.quiz_started = False

# --- Quiz Completion ---
if st.session_state.finished:
    st.success(f"Quiz Completed! Your Score: {st.session_state.score}")
    save_score(st.session_state.email, st.session_state.score)

    # Show comparison chart
    plot_score_comparison(st.session_state.email, st.session_state.score)

# --- Restart Button ---
if st.button("Take Another Quiz"):
    st.session_state.quiz_started = False
    st.session_state.finished = False
    st.session_state.q_index = 0
    st.session_state.score = 0
    st.session_state.user_answers = []
    st.session_state.submitted = False
    st.session_state.selected_field = None
